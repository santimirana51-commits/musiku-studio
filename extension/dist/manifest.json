{
  "manifest_version": 3,
  "name": "MusikKu Universal Music Controller",
  "version": "0.1.0",
  "description": "Kontrol pemutaran: player lokal MusikKu, tab MusikKu, dan tab media lain (sesuai dukungan & izin).",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MusikKu Controller"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "scripting", "offscreen"],
  "optional_host_permissions": ["http://localhost/*", "https://localhost/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
