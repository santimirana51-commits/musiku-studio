{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusikKu",
  "version": "1.0.0",
  "identifier": "com.musikku.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "MusikKu",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
    }
  }
}
