# --- YouTube (server only!) ---
YOUTUBE_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server, JANGAN pernah diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=
# Opsional: batas upload musik cloud dalam MB (default 50)
MUSIC_MAX_FILE_MB=

# --- VPS Stream Proxy (Opsional untuk Equalizer YouTube di Web Production / Vercel) ---
# Alamat VPS Linux mandiri atau Railway yang menjalankan microservice stream-proxy
NEXT_PUBLIC_STREAM_PROXY_URL=
STREAM_PROXY_URL=
